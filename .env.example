# === EquationLens backend configuration ===
# Copy this file to backend/.env and fill in real values.
# The app runs fully in DEMO MODE with no keys at all — every feature below
# is optional and gracefully falls back to deterministic/local behavior.

# OpenAI API key. Used ONLY for natural-language explanation text
# (never for numeric computation — that is always done by SymPy/NumPy/SciPy).
# If left blank, EquationLens uses a built-in template explanation engine
# instead, so the app is fully usable without this key.
OPENAI_API_KEY=

# Model to use for explanations (optional override)
OPENAI_MODEL=gpt-4o-mini

# Max upload size in megabytes
MAX_UPLOAD_MB=15

# Host and Port configuration
HOST=127.0.0.1
PORT=8000

# Comma separated list of allowed CORS origins for the frontend dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080

# Simple in-memory rate limit: requests per minute per IP
RATE_LIMIT_PER_MINUTE=120
